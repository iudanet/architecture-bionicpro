<mxfile host="drawio" type="device">
  <diagram id="BionicPRO C4 security to-be" name="BionicPRO C4 security to-be">
    <mxGraphModel dx="2660" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2660" pageHeight="1560" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;BionicPRO — C4 Container (to-be): управление учётными данными и доступом&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1800" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="BFF как единственный OAuth-клиент, центральный Keycloak-брокер, региональные IdP и локальное хранение ПДн/медданных по странам" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1800" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Центральный контур BionicPRO&lt;/b&gt; (без ПДн и медданных пациентов)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#1168BD;fontSize=13;align=left;verticalAlign=bottom;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="2300" height="580" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Региональный контур: Россия&lt;/b&gt; — ПДн и медданные пациентов РФ не покидают страну" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=2;fontColor=#B85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="320" y="700" width="1110" height="630" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Региональный контур: Страна N (ЕС)&lt;/b&gt; — ПДн и медданные не покидают страну" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=2;fontColor=#B85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="1500" y="700" width="1120" height="630" as="geometry"/></mxCell>
        <mxCell id="p6" value='&lt;b style="font-size:13px"&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Пациент: веб-кабинет и мобильное приложение (Android / iOS)&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="200" height="170" as="geometry"/></mxCell>
        <mxCell id="p7" value='&lt;b style="font-size:13px"&gt;Сотрудник BionicPRO&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Администратор / оператор CRM; вход через корпоративный AD&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="200" height="170" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b style="font-size:13px"&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: nginx + React SPA]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Веб-кабинет пилота. Токенов не хранит; nginx проксирует /bff/* → bff&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#E07B00;strokeWidth=3;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="170" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="c9" value='&lt;b style="font-size:13px"&gt;Мобильное приложение донастройки&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Android / iOS]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Вход через системный браузер → bff; хранит только cookie сессии&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#E07B00;strokeWidth=3;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="320" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;b style="font-size:13px"&gt;Интернет-магазин&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Заказ протезов; вход покупателя через центральный Keycloak&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="470" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="c11" value='&lt;b style="font-size:13px"&gt;bff&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Go — Backend-for-Frontend]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Единственный OAuth-клиент (reports-bff, confidential). Authorization Code + PKCE (S256), state, nonce. Обмен code и refresh — на сервере; браузеру — только HttpOnly cookie &lt;i&gt;bionicpro_session&lt;/i&gt;. Проксирует к reports-api с Bearer, маршрут по claim region&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="310" height="190" as="geometry"/></mxCell>
        <mxCell id="d12" value='&lt;b style="font-size:13px"&gt;Сессионное хранилище BFF&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Redis]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;access / refresh / id token по id сессии, TTL&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;b style="font-size:13px"&gt;Keycloak — центральный брокер&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Keycloak, realm reports-realm]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Identity Brokering к региональным IdP. Клиенты: reports-bff (standard flow, PKCE S256; implicit и direct grants выключены), reports-api (bearer-only). Выдаёт JWT с минимальными claims: sub, роли, region. JWKS для проверки подписи&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#E07B00;strokeWidth=3;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="170" width="520" height="180" as="geometry"/></mxCell>
        <mxCell id="n14" value='&lt;b&gt;Маппинг ролей внешних IdP → роли BionicPRO&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;(Identity Provider Mappers / LDAP group mapper; пример)&lt;/span&gt;&lt;br&gt;&lt;br&gt;• РФ, ЕСИА — пациент → &lt;b&gt;prothetic_user&lt;/b&gt;&lt;br&gt;• РФ, AD-группа администраторов → &lt;b&gt;administrator&lt;/b&gt;&lt;br&gt;• РФ, AD-группа сотрудников → &lt;b&gt;user&lt;/b&gt;&lt;br&gt;• ЕС, eID — пациент → &lt;b&gt;prothetic_user&lt;/b&gt;&lt;br&gt;• ЕС, корпоративные группы → &lt;b&gt;administrator&lt;/b&gt; / &lt;b&gt;user&lt;/b&gt;&lt;br&gt;&lt;br&gt;В токен центральному контуру — только &lt;b&gt;sub&lt;/b&gt;, &lt;b&gt;роли&lt;/b&gt;, &lt;b&gt;region&lt;/b&gt; (RU | EU). ФИО, телефон, адрес, медданные остаются в регионе.' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#222222;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2150" y="170" width="440" height="200" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Защита токенов&lt;/b&gt;&lt;br&gt;• access / refresh / id token живут только в bff (Redis), во фронтенд не передаются&lt;br&gt;• cookie: HttpOnly, Secure, SameSite=Lax; анти-CSRF заголовок X-Requested-With&lt;br&gt;• refresh — на стороне bff; logout — backchannel в Keycloak" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#222222;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2150" y="430" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="c16" value='&lt;b style="font-size:13px"&gt;CRM (РФ)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: CRM + PostgreSQL crm]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ПДн пациентов: clients, prostheses&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="770" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="d17" value='&lt;b style="font-size:13px"&gt;Телеметрия (РФ)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: PostgreSQL telemetry]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;telemetry_events&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="350" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c18" value='&lt;b style="font-size:13px"&gt;Приём телеметрии (РФ)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Realtime-приём событий с протезов&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="1170" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c19" value='&lt;b style="font-size:13px"&gt;Airflow (РФ)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Apache Airflow]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;DAG bionicpro_reports_etl, @hourly&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c20" value='&lt;b style="font-size:13px"&gt;reports-api (РФ)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Go]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;GET /reports; JWT по JWKS Keycloak (iss, aud=reports-api, роль prothetic_user); user = sub&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="770" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="d21" value='&lt;b style="font-size:13px"&gt;ClickHouse (РФ)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: ClickHouse, БД bionicpro]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;витрина report_user_daily&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="910" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c22" value='&lt;b style="font-size:13px"&gt;Региональный IdP РФ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Keycloak, realm ru]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;User Federation (LDAP/AD) и брокер к ЕСИА; учётные данные хранятся в РФ&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="770" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c23" value='&lt;b style="font-size:13px"&gt;Корпоративный LDAP / AD (РФ)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Учётки и группы сотрудников&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c24" value='&lt;b style="font-size:13px"&gt;ЕСИА / Госуслуги&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;OIDC-провайдер для пациентов РФ&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="1170" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;Локальное хранение (152-ФЗ)&lt;/b&gt;&lt;br&gt;ПДн и медданные пациентов РФ хранятся и обрабатываются только в контуре РФ: CRM, телеметрия, ClickHouse, отчёты. Наружу уходят только claims sub, роли, region." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#222222;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="1170" width="490" height="90" as="geometry"/></mxCell>
        <mxCell id="c26" value='&lt;b style="font-size:13px"&gt;Протезы пилотов РФ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Device: прошивка ESP32]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Телеметрия по 4G в реальном времени&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="1390" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="c27" value='&lt;b style="font-size:13px"&gt;Региональный IdP ЕС&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Keycloak, realm eu]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Брокер к национальному eID; учётные данные хранятся в ЕС&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1530" y="770" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c28" value='&lt;b style="font-size:13px"&gt;Национальный eID / IdP страны N&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;SAML 2.0 / OIDC (eIDAS)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1530" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c29" value='&lt;b style="font-size:13px"&gt;reports-api (ЕС)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Go]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;GET /reports; JWT по JWKS Keycloak; user = sub&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1810" y="770" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="d30" value='&lt;b style="font-size:13px"&gt;ClickHouse (ЕС)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: ClickHouse, БД bionicpro]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;витрина report_user_daily&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1810" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c31" value='&lt;b style="font-size:13px"&gt;Airflow (ЕС)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Apache Airflow]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;DAG bionicpro_reports_etl, @hourly&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2090" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c32" value='&lt;b style="font-size:13px"&gt;CRM (ЕС)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: CRM + PostgreSQL crm]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ПДн пациентов: clients, prostheses&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2370" y="770" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="d33" value='&lt;b style="font-size:13px"&gt;Телеметрия (ЕС)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: PostgreSQL telemetry]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;telemetry_events&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2370" y="970" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="c34" value='&lt;b style="font-size:13px"&gt;Приём телеметрии (ЕС)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Realtime-приём событий с протезов&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2370" y="1170" width="210" height="125" as="geometry"/></mxCell>
