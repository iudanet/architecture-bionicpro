<mxfile host="drawio" type="device">
  <diagram id="BionicPRO reports to-be" name="BionicPRO reports to-be">
    <mxGraphModel dx="2220" dy="1520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2220" pageHeight="1520" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;BionicPRO — сервис отчётов (to-be): подготовка витрины и получение отчёта&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1800" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="ETL на Apache Airflow (CRM + телеметрия → ClickHouse), витрина report_user_daily, отчёт через bff → reports-api" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1800" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Источники данных&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="560" height="650" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;sources-db&lt;/b&gt; (PostgreSQL 16)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#8A8A8A;strokeWidth=2;fontColor=#8A8A8A;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="280" height="570" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Apache Airflow&lt;/b&gt; — ETL" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#1168BD;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="720" height="650" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;DAG bionicpro_reports_etl&lt;/b&gt;&lt;br&gt;schedule @hourly · catchup=False · инкремент по watermark (received_at)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#1168BD;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="660" y="265" width="680" height="455" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;ClickHouse&lt;/b&gt; — БД &lt;b&gt;bionicpro&lt;/b&gt; (OLAP)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#1168BD;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="1420" y="90" width="740" height="650" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b style="font-size:13px"&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Ведение клиентов и протезов&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="c9" value='&lt;b style="font-size:13px"&gt;Протезы&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Device: прошивка ESP32]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Телеметрия по 4G&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;b style="font-size:13px"&gt;Приём телеметрии&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container (в стенде: telemetry-simulator)]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Realtime-события с протезов&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="580" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="d11" value='&lt;b style="font-size:13px"&gt;crm&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[БД PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&lt;b&gt;clients&lt;/b&gt;(id, sso_user_id, full_name, email, phone, address, country, created_at)&lt;br&gt;&lt;b&gt;prostheses&lt;/b&gt;(serial, client_id, model, issued_at, telemetry_enabled)&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="240" height="180" as="geometry"/></mxCell>
        <mxCell id="d12" value='&lt;b style="font-size:13px"&gt;telemetry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[БД PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&lt;b&gt;telemetry_events&lt;/b&gt;(event_id, prosthesis_serial, ts, received_at, movement_type, reaction_ms, battery_pct, error_code)&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="500" width="240" height="180" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;b style="font-size:13px"&gt;airflow-webserver&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container, :8081]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;UI, ручной запуск&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="135" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="d14" value='&lt;b style="font-size:13px"&gt;airflow-db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;метаданные Airflow&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="900" y="125" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;b style="font-size:13px"&gt;airflow-scheduler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Планирует и запускает задачи&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="135" width="200" height="95" as="geometry"/></mxCell>
        <mxCell id="c16" value='&lt;b style="font-size:13px"&gt;extract_crm_to_olap&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Task: PythonOperator]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Снимок clients + prostheses (только нужные поля, без телефона/адреса) → crm_prostheses&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="320" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="c17" value='&lt;b style="font-size:13px"&gt;extract_telemetry_to_olap&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Task: PythonOperator]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;События с received_at в (watermark, data_interval_end] → telemetry_raw; XCom: затронутые даты&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="550" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="c18" value='&lt;b style="font-size:13px"&gt;build_report_mart&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Task]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;INSERT…SELECT дневных агрегатов за затронутые даты&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="425" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="c19" value='&lt;b style="font-size:13px"&gt;update_watermark&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Task]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;loaded_until = data_interval_end&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="610" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Пользователи ClickHouse&lt;/b&gt;&lt;br&gt;• &lt;b&gt;etl_writer&lt;/b&gt; — Airflow, запись&lt;br&gt;• &lt;b&gt;reports_reader&lt;/b&gt; — reports-api, только SELECT на report_user_daily и etl_watermark" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#222222;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1450" y="135" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="c21" value='&lt;b style="font-size:13px"&gt;crm_prostheses&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Table: ReplacingMergeTree(synced_at)]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ORDER BY prosthesis_serial&lt;br&gt;serial, model, issued_at, user_id (= sso_user_id), full_name, country&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="300" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="c22" value='&lt;b style="font-size:13px"&gt;telemetry_raw&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Table: ReplacingMergeTree]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;PARTITION BY toYYYYMM(ts)&lt;br&gt;ORDER BY (prosthesis_serial, ts, event_id)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="530" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="c23" value='&lt;b style="font-size:13px"&gt;report_user_daily — витрина&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Table: ReplacingMergeTree(built_at)]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&lt;b&gt;PARTITION BY toYYYYMM(date)&lt;br&gt;ORDER BY (user_id, prosthesis_serial, date)&lt;/b&gt;&lt;br&gt;&lt;br&gt;user_id, full_name, country, prosthesis_serial, prosthesis_model, date, movements, avg_reaction_ms, p95_reaction_ms, max_reaction_ms, slow_reactions (&amp;gt;100 мс), errors, avg_battery_pct, min_battery_pct, built_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Ключ сортировки начинается с user_id — отчёт пользователя читается диапазоном без полного скана&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1780" y="135" width="330" height="420" as="geometry"/></mxCell>
        <mxCell id="c24" value='&lt;b style="font-size:13px"&gt;etl_watermark&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Table: ReplacingMergeTree(updated_at)]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ORDER BY pipeline&lt;br&gt;pipeline, loaded_until, updated_at&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1780" y="595" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p25" value='&lt;b style="font-size:13px"&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Роль prothetic_user&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="200" height="170" as="geometry"/></mxCell>
        <mxCell id="c26" value='&lt;b style="font-size:13px"&gt;frontend — React SPA&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: в браузере]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Кнопка «Получить отчёт» → fetch /bff/api/reports; токенов не видит&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#E07B00;strokeWidth=3;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="825" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="c27" value='&lt;b style="font-size:13px"&gt;nginx&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: frontend, :3000]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;location /bff/* → bff:8000/* (same-origin, без CORS)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#E07B00;strokeWidth=3;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="825" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="c28" value='&lt;b style="font-size:13px"&gt;bff&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Go]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Cookie bionicpro_session → серверная сессия → access token; при истечении — refresh; проксирует с Authorization: Bearer&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="815" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="c29" value='&lt;b style="font-size:13px"&gt;reports-api&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Go]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&lt;b&gt;GET /reports&lt;/b&gt;: JWT по JWKS Keycloak (iss, aud=reports-api, роль prothetic_user); user = sub; период обрезается по loaded_until; только SELECT из витрины, без тяжёлых вычислений&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="805" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="c30" value='&lt;b style="font-size:13px"&gt;keycloak&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Keycloak, realm reports-realm]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Выдача токенов (Authorization Code + PKCE S256, клиент reports-bff); JWKS для проверки подписи&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#E07B00;strokeWidth=3;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="1090" width="480" height="110" as="geometry"/></mxCell>
        <mxCell id="n31" value='&lt;b&gt;Правила доступа к отчёту (reports-api)&lt;/b&gt;&lt;table style="font-size:11px;border-collapse:collapse;margin-top:6px" border="1" cellpadding="4"&gt;&lt;tr&gt;&lt;th align="left"&gt;Ситуация&lt;/th&gt;&lt;th&gt;Ответ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Нет сессии / нет или невалиден JWT&lt;/td&gt;&lt;td align="center"&gt;401&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Нет роли prothetic_user или user_id ≠ sub&lt;/td&gt;&lt;td align="center"&gt;403&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Весь период позже loaded_until&lt;/td&gt;&lt;td align="center"&gt;422 period_not_processed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ETL ещё ни разу не прошёл&lt;/td&gt;&lt;td align="center"&gt;503 report_not_ready&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Иначе: только свои строки (user_id = sub), период ≤ loaded_until&lt;/td&gt;&lt;td align="center"&gt;200&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#222222;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1800" y="960" width="400" height="215" as="geometry"/></mxCell>
        <mxCell id="e32" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="d11"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e33" value="4G, TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
